<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LifeManagementApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Etusivu"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#240046">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Life Management App"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#E0AAFF" />

            <!-- Sää -->

            <Frame
                Padding="15"
                BackgroundColor="Black"
                BorderColor="#9D4EDD">

                <VerticalStackLayout>

                    <Label
                        Text="🌤 Nykyinen sää"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="{Binding TemperatureText}"
                        TextColor="White" />

                    <Label
                        Text="{Binding WindText}"
                        TextColor="White" />

                    <Label
                        Text="{Binding KitesurfText}"
                        TextColor="#7CFC00"
                        FontAttributes="Bold" />

                </VerticalStackLayout>

            </Frame>

            <!-- Tärkeimmät tehtävät -->

            <Frame
                Padding="15"
                BackgroundColor="Black"
                BorderColor="#9D4EDD">

                <VerticalStackLayout>

                    <Label
                        Text="📋 Tärkeimmät tehtävät"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <CollectionView
                        ItemsSource="{Binding TopTodos}">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <VerticalStackLayout Padding="5">

                                    <Label
                                        Text="{Binding Title}"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="{Binding PriorityText}"
                                        TextColor="White" />

                                </VerticalStackLayout>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>