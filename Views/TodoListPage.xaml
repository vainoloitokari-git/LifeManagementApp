<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LifeManagementApp.Views.TodoListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout Padding="20">

        <Label
            Text="Todo List"
            FontSize="28"
            FontAttributes="Bold" />

        <CollectionView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="0,5">

                        <VerticalStackLayout>

                            <Label
                                Text="Esimerkkitehtävä"
                                FontAttributes="Bold" />

                            <Label
                                Text="Prioriteetti: 1" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>