<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LifeManagementApp.Views.TodoListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Todos"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#240046">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- Otsikko -->

            <Label
                Text="Tehtävälista"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#E0AAFF" />

            <!-- Lisää tehtävä -->

            <Frame
                Padding="15"
                BackgroundColor="Black"
                BorderColor="#9D4EDD">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Lisää tehtävä"
                        TextColor="White" />

                    <Entry
                        Placeholder="Tehtävän nimi"
                        Text="{Binding NewTodoTitle}"
                        BackgroundColor="Black"
                        TextColor="White"
                        PlaceholderColor="Gray" />

                    <Label
                        Text="Prioriteetti"
                        TextColor="White" />

                    <Picker
                        BackgroundColor="Black"
                        TextColor="White"
                        ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding SelectedPriorityText}" />

                    <Button
                        Text="Lisää"
                        Command="{Binding AddTodoCommand}"
                        BackgroundColor="#BFA2DB"
                        TextColor="Black" />

                </VerticalStackLayout>

            </Frame>

            <!-- Lajittelu -->

            <Frame
                Padding="15"
                BackgroundColor="Black"
                BorderColor="#9D4EDD">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Lajittele"
                        TextColor="White" />

                    <Picker
                        BackgroundColor="Black"
                        TextColor="White"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}" />

                </VerticalStackLayout>

            </Frame>

            <!-- Tehtävälista -->

            <CollectionView
                ItemsSource="{Binding Todos}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="12"
                            BackgroundColor="Black"
                            BorderColor="#9D4EDD">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="{Binding PriorityText}"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>