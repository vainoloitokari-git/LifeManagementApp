<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="LifeManagementApp.Views.TodoListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Todos"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#240046">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Tehtävälista"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Uusi tehtävä -->

            <Frame Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Entry
                        Placeholder="Tehtävän nimi"
                        Text="{Binding NewTodoTitle}" />

                    <Picker
                        Title="Prioriteetti"
                        ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding SelectedPriorityText}" />

                    <Button
                        Text="Lisää tehtävä"
                        Command="{Binding AddTodoCommand}" />

                </VerticalStackLayout>

            </Frame>

            <!-- Tehtävälista -->

            <CollectionView
                ItemsSource="{Binding Todos}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="10">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding PriorityText}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>